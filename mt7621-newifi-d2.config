# ==============================================================================
# 🌟 newifi-d2 OpenWrt 25.12 完整配置 mt7621 newifi-d2
# ==============================================================================

# === 核心目标平台与设备 ===
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y

# === DNS和WiFi 认证栈 ===
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set
# CONFIG_PACKAGE_wpad is not set
# CONFIG_PACKAGE_wpad-mbedtls is not set
# CONFIG_PACKAGE_wpad-wolfssl is not set
CONFIG_PACKAGE_wpad-openssl=y

# === LuCI 主题界面与中文化 ===
CONFIG_PACKAGE_luci=y
# CONFIG_PACKAGE_luci-light is not set
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_ucode-mod-math=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-lib-base=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-mod-rpc=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_luci-lib-ip=y
CONFIG_PACKAGE_luci-lib-httpprotoutils=y

# === 防火墙 ===
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# === 基础组件 ===
# CONFIG_PACKAGE_wget-nossl is not set
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_curl=y
# CONFIG_PACKAGE_nftables-nojson is not set
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_ip-full=y

# === 支持国际化域名 ===
# CONFIG_PACKAGE_clixon is not set
CONFIG_PACKAGE_libidn2=y
CONFIG_PACKAGE_libintl-full=y
CONFIG_LIBCURL_LIBIDN2=y

# --- 局域网共享 ---
CONFIG_PACKAGE_luci-app-ksmbd=y
CONFIG_PACKAGE_luci-i18n-ksmbd-zh-cn=y

# --- 硬盘/U盘全自动休眠插件 ---
CONFIG_PACKAGE_luci-app-hd-idle=y
CONFIG_PACKAGE_luci-i18n-hd-idle-zh-cn=y

# --- 压缩与解压 ---
CONFIG_PACKAGE_gzip=y
CONFIG_PACKAGE_zstd=y
CONFIG_PACKAGE_pigz=y

# === Force disable Nginx ===
# CONFIG_PACKAGE_nginx is not set
# CONFIG_PACKAGE_nginx-ssl is not set
# CONFIG_PACKAGE_nginx-mod-luci is not set
# CONFIG_PACKAGE_luci-nginx is not set
# CONFIG_PACKAGE_nginx-mod-dav-ext is not set
# CONFIG_PACKAGE_nginx-mod-headers-more is not set
# CONFIG_PACKAGE_nginx-mod-brotli is not set
# CONFIG_PACKAGE_nginx-mod-zstd is not set

# === 分区与格式化 ===
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_libblkid=y
CONFIG_PACKAGE_libmount=y
CONFIG_PACKAGE_libsmartcols=y
CONFIG_PACKAGE_libuuid=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_libext2fs=y
CONFIG_PACKAGE_libcomerr=y
CONFIG_PACKAGE_libss=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_mkf2fs=y
CONFIG_PACKAGE_libf2fs=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ksmbd=y
CONFIG_PACKAGE_kmod-fuse=y
CONFIG_PACKAGE_kmod-nls-base=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-utf8=y

# === DNS 支持 ===
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y

# === ZRAM 内存压缩 ===
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-lib-lzo=y
CONFIG_PACKAGE_kmod-lib-lz4=y
CONFIG_PACKAGE_kmod-lib-zstd=y

# === SWAP 支持 ===
CONFIG_PACKAGE_swap-utils=y

# === 集客AC控制器 ===
CONFIG_PACKAGE_luci-app-gecoosac=y
CONFIG_PACKAGE_luci-i18n-gecoosac-zh-cn=y

# === QoS 支持 ===
CONFIG_PACKAGE_luci-app-qosify=y
CONFIG_PACKAGE_luci-i18n-qosify-zh-cn=y
